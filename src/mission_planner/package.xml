<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_planner</name>
  <version>0.1.0</version>
  <description>YAML and QGroundControl mission loader with an arm, takeoff, waypoint, RTL, and land state machine.</description>
  <maintainer email="applycoding@users.noreply.github.com">Arpan Bom</maintainer>
  <license>MIT</license>

  <depend>geometry_msgs</depend>
  <depend>interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
